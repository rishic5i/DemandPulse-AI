# Supported: groq | auto | openrouter
# Prefer groq for fast Full Demo (openai/gpt-oss-20b free tier).
AI_PROVIDER=groq
AI_FAILOVER=true

GROQ_API_KEY=
# Prefer qwen for free-tier demo speed/quality. gpt-oss-20b is fine when TPD remains.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional failover when Groq is rate-limited (free models only).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
